{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "mockniner-webmcp",
  "main": "worker/audioAssets.ts",
  "compatibility_date": "2026-09-03",
  "workers_dev": true,
  "preview_urls": false,
  "routes": [],
  "assets": {
    "binding": "ASSETS",
    "run_worker_first": ["/audio-assets/*"],
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  "r2_buckets": [{ "binding": "AUDIO_ASSETS", "bucket_name": "mockniner-audio-assets", "remote": true }]
}
