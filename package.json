{
  "name": "mockniner",
  "private": true,
  "version": "0.0.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "deploy": "npm run build && wrangler deploy",
    "preview:workers": "npm run build && wrangler dev",
    "lint": "oxlint",
    "test": "vitest run --maxWorkers=4",
    "eval:agent:smoke": "node scripts/agent-evals/smoke.mjs",
    "eval:agent:local": "node scripts/agent-evals/run.mjs local",
    "eval:agent:browser": "node scripts/agent-evals/run.mjs browser",
    "eval:agent:release": "node scripts/agent-evals/run.mjs browser --release",
    "preview": "vite preview",
    "audio:prepare": "node scripts/audio-assets/prepare.mjs",
    "audio:upload": "node scripts/audio-assets/prepare.mjs --upload",
    "typecheck:worker": "wrangler types && tsc --ignoreConfig --noEmit --strict --skipLibCheck --target ES2023 --module ESNext --moduleResolution Bundler --resolveJsonModule --types node worker-configuration.d.ts worker/audioAssets.ts",
    "audio:verify": "node scripts/audio-assets/verify.mjs"
  },
  "dependencies": {
    "@huggingface/transformers": "3.8.1",
    "clsx": "^2.1.1",
    "kokoro-js": "1.2.1",
    "lucide-react": "^0.563.0",
    "phonemizer": "1.2.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sqlocal": "^0.18.0",
    "tailwind-merge": "^3.5.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.18",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "happy-dom": "^20.13.1",
    "oxlint": "^1.79.0",
    "tailwindcss": "^4.1.18",
    "typescript": "~6.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11",
    "webmcp-evals": "0.0.4",
    "webmcp-types": "^0.1.5",
    "wrangler": "4.128.0"
  }
}
