{
  "name": "webmcp-assessment-lab",
  "private": true,
  "version": "0.0.0",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "test": "vitest run",
    "eval:agent:smoke": "node scripts/agent-evals/prepare.mjs && webmcp-evals smoke --url \"${AGENT_EVAL_URL:-http://127.0.0.1:5173/}\" --evals .evals/agent-authoring/fixtures/smoke-evals.json",
    "eval:agent:local": "node scripts/agent-evals/run.mjs local",
    "eval:agent:browser": "node scripts/agent-evals/run.mjs browser",
    "eval:agent:release": "node scripts/agent-evals/run.mjs browser --release",
    "preview": "vite preview"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "kokoro-js": "1.2.1",
    "lucide-react": "^0.563.0",
    "phonemizer": "1.2.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sqlocal": "^0.18.0",
    "tailwind-merge": "^3.5.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.18",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "happy-dom": "^20.13.1",
    "oxlint": "^1.79.0",
    "tailwindcss": "^4.1.18",
    "typescript": "~6.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11",
    "webmcp-evals": "0.0.4",
    "webmcp-types": "^0.1.5"
  }
}
